{
  "version": 1,
  "description": "Recipe costing \u2014 computeProductCost and computeCostBreakdown",
  "targets": ["backend", "desktop"],
  "scenarios": [
    {
      "id": "costing-001",
      "description": "computeProductCost: basic ingredient cost with waste",
      "function": "computeProductCost",
      "targets": ["backend", "desktop"],
      "input": {
        "ingredients": [{ "quantity": 10, "wastePercent": 10, "costPerUnit": 0.5 }],
        "packaging": [],
        "productCost": 0,
        "costPercent": 100
      },
      "expectedOutput": 5.5,
      "type": "number",
      "tags": ["smoke"]
    },
    {
      "id": "costing-002",
      "description": "computeProductCost: multiple ingredients",
      "function": "computeProductCost",
      "targets": ["backend", "desktop"],
      "input": {
        "ingredients": [
          { "quantity": 10, "wastePercent": 10, "costPerUnit": 0.5 },
          { "quantity": 20, "wastePercent": 0, "costPerUnit": 0.3 },
          { "quantity": 5, "wastePercent": 5, "costPerUnit": 2.0 }
        ],
        "packaging": [],
        "productCost": 0,
        "costPercent": 100
      },
      "expectedOutput": 22.0,
      "type": "number",
      "tags": ["smoke"]
    },
    {
      "id": "costing-003",
      "description": "computeProductCost: empty recipe uses productCost fallback",
      "function": "computeProductCost",
      "targets": ["backend", "desktop"],
      "input": {
        "ingredients": [],
        "packaging": [],
        "productCost": 15.0,
        "costPercent": 100
      },
      "expectedOutput": 15.0,
      "type": "number",
      "tags": ["smoke"]
    },
    {
      "id": "costing-004",
      "description": "computeProductCost: zero waste percent",
      "function": "computeProductCost",
      "targets": ["backend", "desktop"],
      "input": {
        "ingredients": [{ "quantity": 10, "wastePercent": 0, "costPerUnit": 0.5 }],
        "packaging": [],
        "productCost": 0,
        "costPercent": 100
      },
      "expectedOutput": 5.0,
      "type": "number",
      "tags": ["edge-case"]
    },
    {
      "id": "costing-005",
      "description": "computeProductCost: size costPercent adjustment (80%)",
      "function": "computeProductCost",
      "targets": ["backend", "desktop"],
      "input": {
        "ingredients": [{ "quantity": 10, "wastePercent": 0, "costPerUnit": 1.0 }],
        "packaging": [],
        "productCost": 0,
        "costPercent": 80
      },
      "expectedOutput": 8.0,
      "type": "number",
      "tags": ["pricing"]
    },
    {
      "id": "costing-006",
      "description": "computeProductCost: size costPercent adjustment (0%)",
      "function": "computeProductCost",
      "targets": ["backend", "desktop"],
      "input": {
        "ingredients": [{ "quantity": 10, "wastePercent": 0, "costPerUnit": 1.0 }],
        "packaging": [],
        "productCost": 0,
        "costPercent": 0
      },
      "expectedOutput": 0.0,
      "type": "number",
      "tags": ["edge-case"]
    },
    {
      "id": "costing-007",
      "description": "computeProductCost: packaging materials included",
      "function": "computeProductCost",
      "targets": ["backend", "desktop"],
      "input": {
        "ingredients": [{ "quantity": 10, "wastePercent": 0, "costPerUnit": 1.0 }],
        "packaging": [
          { "quantity": 1, "costPerUnit": 2.0 },
          { "quantity": 1, "costPerUnit": 0.5 }
        ],
        "productCost": 0,
        "costPercent": 100
      },
      "expectedOutput": 12.5,
      "type": "number",
      "tags": ["smoke"]
    },
    {
      "id": "costing-008",
      "description": "computeProductCost: no packaging, ingredients only",
      "function": "computeProductCost",
      "targets": ["backend", "desktop"],
      "input": {
        "ingredients": [{ "quantity": 10, "wastePercent": 0, "costPerUnit": 0.5 }],
        "packaging": [],
        "productCost": 0,
        "costPercent": 100
      },
      "expectedOutput": 5.0,
      "type": "number",
      "tags": ["smoke"]
    },
    {
      "id": "costing-009",
      "description": "computeCostBreakdown: normal case with all 5 components",
      "function": "computeCostBreakdown",
      "targets": ["backend"],
      "input": {
        "productId": "prod-1",
        "productName": "Test Product",
        "sellingPrice": 50,
        "ingredients": [{ "itemName": "Coffee", "quantity": 10, "unit": "g", "costPerUnit": 0.5, "total": 5.0 }],
        "totalLaborCost": 1000,
        "totalOrders": 100,
        "productOrderCount": 10,
        "totalItemsSold": 200,
        "totalOperationalExpenses": 5000,
        "totalUtilityCost": 500,
        "dateFrom": "2026-07-01T00:00:00.000Z",
        "dateTo": "2026-07-15T00:00:00.000Z"
      },
      "expectedOutput": {
        "productId": "prod-1",
        "productName": "Test Product",
        "sellingPrice": 50,
        "estimatedCost": 33.0,
        "estimatedProfit": 17.0,
        "profitMargin": 34.0,
        "ingredientCost": 5.0,
        "laborCost": 0.5,
        "operationalCost": 12.5,
        "utilityCost": 2.5,
        "miscellaneousCost": 12.5,
        "laborDetails": { "totalLaborCostPeriod": 1000, "totalOrdersInPeriod": 100, "productOrderCount": 10 },
        "dateRange": { "from": "2026-07-01T00:00:00.000Z", "to": "2026-07-15T00:00:00.000Z" },
        "ingredientBreakdown": [{ "itemName": "Coffee", "quantity": 10, "unit": "g", "costPerUnit": 0.5, "total": 5.0 }]
      },
      "type": "object",
      "tags": ["smoke"]
    },
    {
      "id": "costing-010",
      "description": "computeCostBreakdown: zero sales (totalItemsSold=0)",
      "function": "computeCostBreakdown",
      "targets": ["backend"],
      "input": {
        "productId": "prod-2",
        "productName": "Zero Sales",
        "sellingPrice": 20,
        "ingredients": [],
        "totalLaborCost": 1000,
        "totalOrders": 0,
        "productOrderCount": 0,
        "totalItemsSold": 0,
        "totalOperationalExpenses": 0,
        "totalUtilityCost": 0,
        "dateFrom": "2026-07-01T00:00:00.000Z",
        "dateTo": "2026-07-15T00:00:00.000Z"
      },
      "expectedOutput": {
        "productId": "prod-2",
        "productName": "Zero Sales",
        "sellingPrice": 20,
        "estimatedCost": 0.0,
        "estimatedProfit": 20.0,
        "profitMargin": 100.0,
        "ingredientCost": 0.0,
        "laborCost": 0.0,
        "operationalCost": 0.0,
        "utilityCost": 0.0,
        "miscellaneousCost": 0.0,
        "laborDetails": { "totalLaborCostPeriod": 1000, "totalOrdersInPeriod": 0, "productOrderCount": 0 },
        "dateRange": { "from": "2026-07-01T00:00:00.000Z", "to": "2026-07-15T00:00:00.000Z" },
        "ingredientBreakdown": []
      },
      "type": "object",
      "tags": ["edge-case"]
    },
    {
      "id": "costing-011",
      "description": "computeCostBreakdown: rounding edge cases (1/3 quantity)",
      "function": "computeCostBreakdown",
      "targets": ["backend"],
      "input": {
        "productId": "prod-3",
        "productName": "Rounding Test",
        "sellingPrice": 10,
        "ingredients": [{ "itemName": "Milk", "quantity": 0.333333, "unit": "ml", "costPerUnit": 10, "total": 3.33333 }],
        "totalLaborCost": 100,
        "totalOrders": 3,
        "productOrderCount": 1,
        "totalItemsSold": 7,
        "totalOperationalExpenses": 21,
        "totalUtilityCost": 7,
        "dateFrom": "2026-07-01T00:00:00.000Z",
        "dateTo": "2026-07-15T00:00:00.000Z"
      },
      "expectedOutput": {
        "productId": "prod-3",
        "productName": "Rounding Test",
        "sellingPrice": 10,
        "estimatedCost": 12.1,
        "estimatedProfit": -2.1,
        "profitMargin": -20.95,
        "ingredientCost": 3.33,
        "laborCost": 4.76,
        "operationalCost": 1.5,
        "utilityCost": 1.0,
        "miscellaneousCost": 1.5,
        "laborDetails": { "totalLaborCostPeriod": 100, "totalOrdersInPeriod": 3, "productOrderCount": 1 },
        "dateRange": { "from": "2026-07-01T00:00:00.000Z", "to": "2026-07-15T00:00:00.000Z" },
        "ingredientBreakdown": [{ "itemName": "Milk", "quantity": 0.333333, "unit": "ml", "costPerUnit": 10, "total": 3.33333 }]
      },
      "type": "object",
      "tags": ["regression"]
    },
    {
      "id": "costing-012",
      "description": "computeCostBreakdown: negative profit (cost > price)",
      "function": "computeCostBreakdown",
      "targets": ["backend"],
      "input": {
        "productId": "prod-4",
        "productName": "Loss Leader",
        "sellingPrice": 10,
        "ingredients": [{ "itemName": "Premium Beans", "quantity": 50, "unit": "g", "costPerUnit": 0.5, "total": 25.0 }],
        "totalLaborCost": 500,
        "totalOrders": 50,
        "productOrderCount": 5,
        "totalItemsSold": 100,
        "totalOperationalExpenses": 2000,
        "totalUtilityCost": 200,
        "dateFrom": "2026-07-01T00:00:00.000Z",
        "dateTo": "2026-07-15T00:00:00.000Z"
      },
      "expectedOutput": {
        "productId": "prod-4",
        "productName": "Loss Leader",
        "sellingPrice": 10,
        "estimatedCost": 47.5,
        "estimatedProfit": -37.5,
        "profitMargin": -375.0,
        "ingredientCost": 25,
        "laborCost": 0.5,
        "operationalCost": 10,
        "utilityCost": 2,
        "miscellaneousCost": 10,
        "laborDetails": { "totalLaborCostPeriod": 500, "totalOrdersInPeriod": 50, "productOrderCount": 5 },
        "dateRange": { "from": "2026-07-01T00:00:00.000Z", "to": "2026-07-15T00:00:00.000Z" },
        "ingredientBreakdown": [{ "itemName": "Premium Beans", "quantity": 50, "unit": "g", "costPerUnit": 0.5, "total": 25.0 }]
      },
      "type": "object",
      "tags": ["edge-case"]
    },
    {
      "id": "costing-013",
      "description": "computeCostBreakdown: only labor, no ingredients",
      "function": "computeCostBreakdown",
      "targets": ["backend"],
      "input": {
        "productId": "prod-5",
        "productName": "Service Only",
        "sellingPrice": 5,
        "ingredients": [],
        "totalLaborCost": 5000,
        "totalOrders": 50,
        "productOrderCount": 10,
        "totalItemsSold": 100,
        "totalOperationalExpenses": 0,
        "totalUtilityCost": 0,
        "dateFrom": "2026-07-01T00:00:00.000Z",
        "dateTo": "2026-07-15T00:00:00.000Z"
      },
      "expectedOutput": {
        "productId": "prod-5",
        "productName": "Service Only",
        "sellingPrice": 5,
        "estimatedCost": 10.0,
        "estimatedProfit": -5.0,
        "profitMargin": -100.0,
        "ingredientCost": 0.0,
        "laborCost": 10.0,
        "operationalCost": 0.0,
        "utilityCost": 0.0,
        "miscellaneousCost": 0.0,
        "laborDetails": { "totalLaborCostPeriod": 5000, "totalOrdersInPeriod": 50, "productOrderCount": 10 },
        "dateRange": { "from": "2026-07-01T00:00:00.000Z", "to": "2026-07-15T00:00:00.000Z" },
        "ingredientBreakdown": []
      },
      "type": "object",
      "tags": ["edge-case"]
    }
  ]
}
