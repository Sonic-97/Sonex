# =============================================================================
# Sonex Docker — Environment Configuration
# =============================================================================
# This file is used by docker-compose.yml for local development.
# Override any value via environment variables before production.
# =============================================================================

# Database
POSTGRES_DB=sonex
POSTGRES_USER=sonex_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://sonex_user:change-me@postgres:5432/sonex

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Application
NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost:3000

# WhatsApp (optional — fill for production)
WHATSAPP_PROVIDER=openwa
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# AI (optional)
DEEPSEEK_API_KEY=
