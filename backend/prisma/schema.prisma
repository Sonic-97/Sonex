  paymentsRefunded Json?
  processedById    String?   @map("processed_by_id")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  order            UnifiedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cafe             Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  processedBy      Staff?       @relation(fields: [processedById], references: [id])

  @@index([orderId])
  @@index([cafeId, createdAt])
  @@map("unified_refunds")
}

model OnboardingSession {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId          String   @map("cafe_id")
  currentStep     Int      @default(0)
  status          String   @default("IN_PROGRESS") // PENDING | IN_PROGRESS | COMPLETED | ABANDONED
  stepData        Json     @default("{}")
  completedSteps  Json     @default("[]")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  cafe            Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId])
  @@index([cafeId, status])
  @@map("onboarding_sessions")
}

model Tax {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId    String   @map("cafe_id")
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  type      String   @default("PERCENTAGE") // PERCENTAGE | FLAT
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@map("taxes")
}

model PaymentMethod {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId    String   @map("cafe_id")
  name      String
  type      String   @default("CASH") // CASH | CARD | ONLINE | OTHER
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@map("payment_methods")
}

model Supplier {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId    String   @map("cafe_id")
  name      String
  phone     String?
  email     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@map("suppliers")
}

model CustomerOrder {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  customerId      String?   @map("customer_id")
  customerName    String?
  customerPhone   String?
  address         String?
  deliveryMethod  String    @default("DELIVERY") @map("delivery_method")

  status          String    @default("CREATED")

  subtotal        Decimal   @default(0) @db.Decimal(10, 2)
  deliveryFee     Decimal   @default(0) @db.Decimal(10, 2)
  grandTotal      Decimal   @default(0) @db.Decimal(10, 2)

  driverId        String?   @map("driver_id")

  readyMerchantCount Int    @default(0) @map("ready_merchant_count")
  totalMerchantCount  Int   @default(0) @map("total_merchant_count")

  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  completedAt     DateTime? @db.Timestamptz(6) @map("completed_at")
  cancelledAt     DateTime? @db.Timestamptz(6) @map("cancelled_at")

  merchantOrders  MerchantOrder[]
  driver          Driver?   @relation(fields: [driverId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([driverId])
  @@map("customer_orders")
}

model MerchantOrder {
  id                      String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  customerOrderId         String              @map("customer_order_id")
  cafeId                  String              @map("cafe_id")
  unifiedOrderId          String?             @map("unified_order_id")
  businessName            String?
  businessType            String              @default("general") @map("business_type")

  status                  String              @default("CREATED")
  cancellationReason      String?             @map("cancellation_reason")

  preparationTimeMinutes  Int                 @default(15) @map("preparation_time_minutes")
  estimatedReadyAt        DateTime?           @db.Timestamptz(6) @map("estimated_ready_at")
  acceptedAt              DateTime?           @db.Timestamptz(6) @map("accepted_at")
  startedAt               DateTime?           @db.Timestamptz(6) @map("started_at")
  readyAt                 DateTime?           @db.Timestamptz(6) @map("ready_at")
  pickedUpAt              DateTime?           @db.Timestamptz(6) @map("picked_up_at")
  completedAt             DateTime?           @db.Timestamptz(6) @map("completed_at")
  cancelledAt             DateTime?           @db.Timestamptz(6) @map("cancelled_at")

  pickupSequence          Int                 @default(0) @map("pickup_sequence")

  createdAt               DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(6)

  customerOrder           CustomerOrder       @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  cafe                    Cafe                @relation(fields: [cafeId], references: [id])
  unifiedOrder            UnifiedOrder?       @relation(fields: [unifiedOrderId], references: [id])
  items                   MerchantOrderItem[]
  driverAssignments       DriverAssignment[]

  @@index([customerOrderId])
  @@index([cafeId])
  @@index([status])
  @@map("merchant_orders")
}

model MerchantOrderItem {
  id              String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantOrderId String         @map("merchant_order_id")
  productName     String         @map("product_name")
  quantity        Int
  unitPrice       Decimal        @db.Decimal(10, 2) @map("unit_price")
  totalPrice      Decimal        @db.Decimal(10, 2) @map("total_price")
  notes           String?

  merchantOrder   MerchantOrder  @relation(fields: [merchantOrderId], references: [id], onDelete: Cascade)

  @@index([merchantOrderId])
  @@map("merchant_order_items")
}

model DriverAssignment {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  driverId        String          @map("driver_id")
  merchantOrderId String          @map("merchant_order_id")
  status          String          @default("PENDING")
  score           Decimal?        @db.Decimal(10, 2)
  assignedAt      DateTime        @default(now()) @db.Timestamptz(6)
  respondedAt     DateTime?       @db.Timestamptz(6) @map("responded_at")
  expiresAt       DateTime?       @db.Timestamptz(6) @map("expires_at")

  driver          Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  merchantOrder   MerchantOrder   @relation(fields: [merchantOrderId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
  @@index([merchantOrderId])
  @@index([status])
  @@map("driver_assignments")
}

model MerchantMessage {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId      String    @map("merchant_id")
  merchantOrderId String    @map("merchant_order_id")
  customerOrderId String    @map("customer_order_id")
  messageType     String    @map("message_type")
  responseType    String?   @map("response_type")
  payload         Json      @default("{}")
  metadata        Json      @default("{}")
  version         Int       @default(1)
  status          String    @default("PENDING")
  errorCode       String?   @map("error_code")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6) @map("processed_at")

  @@index([merchantId, merchantOrderId])
  @@index([merchantOrderId])
  @@index([messageType, status])
  @@map("merchant_messages")
}

model MerchantAvailability {
  id                      String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId                  String    @unique @map("cafe_id")
  status                  String    @default("OPEN")
  queueLength             Int       @default(0) @map("queue_length")
  currentETA              Int       @default(0) @map("current_eta")
  averagePreparationTime  Int       @default(15) @map("average_preparation_time")
  maxQueue                Int       @default(10) @map("max_queue")
  maxConcurrentOrders     Int       @default(5) @map("max_concurrent_orders")
  activeOrderCount        Int       @default(0) @map("active_order_count")
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)

  cafe                    Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@map("merchant_availability")
}

model MerchantReview {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  customerId      String   @map("customer_id")
  merchantId      String   @map("merchant_id")
  merchantOrderId String   @unique @map("merchant_order_id")
  ratings         Json     @default("{}")
  comment         String?
  verified        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@index([merchantId])
  @@index([customerId])
  @@index([merchantId, createdAt])
  @@map("merchant_reviews")
}

model MerchantReputation {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId        String   @unique @map("merchant_id")
  trustScore        Decimal  @default(0) @db.Decimal(5, 2)
  totalReviews      Int      @default(0)
  averageRating     Decimal  @default(0) @db.Decimal(3, 2)
  complaintCount    Int      @default(0)
  successRate       Decimal  @default(0) @db.Decimal(5, 2)
  cancellationRate  Decimal  @default(0) @db.Decimal(5, 2)
  badges            Json     @default("[]")
  alerts            Json     @default("[]")
  lastCalculated    DateTime @default(now()) @db.Timestamptz(6) @map("last_calculated")
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@map("merchant_reputations")
}

enum DynamicPricingRuleType {
  FIXED_DISCOUNT
  PERCENTAGE_DISCOUNT
  PRICE_OVERRIDE
  CATEGORY_DISCOUNT
  TIME_WINDOW
  DAY_OF_WEEK
  MINIMUM_QUANTITY
}

model DynamicPricingRule {
  id                 String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId             String                @map("cafe_id")
  name               String
  ruleType           DynamicPricingRuleType @map("rule_type")
  enabled            Boolean               @default(true)
  priority           Int                   @default(0)
  value              Decimal               @db.Decimal(10, 2)
  currency           String                @default("SAR")
  conditions         Json                  @default("{}")
  productIds         Json?                 @map("product_ids")
  categoryIds        Json?                 @map("category_ids")
  validFrom          DateTime?             @db.Timestamptz(6) @map("valid_from")
  validTo            DateTime?             @db.Timestamptz(6) @map("valid_to")
  maxRedemptions     Int?                  @map("max_redemptions")
  currentRedemptions Int                   @default(0) @map("current_redemptions")
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  cafe               Cafe                  @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@index([cafeId, enabled])
  @@index([cafeId, ruleType])
  @@index([cafeId, priority])
  @@map("dynamic_pricing_rules")
}

model DeliveryZone {
  id           String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  branchId     String               @map("branch_id")
  cafeId       String?              @map("cafe_id")
  name         String
  mainStreet   String               @map("main_street")
  deliveryFee  Decimal              @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  minimumOrder Decimal              @default(0) @db.Decimal(10, 2) @map("minimum_order")
  etaMinutes   Int                  @default(30) @map("eta_minutes")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6) @map("updated_at")
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cafe         Cafe?                @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  streets      DeliveryZoneStreet[]
  locations    CustomerLocation[]

  @@index([branchId])
  @@index([cafeId])
  @@index([mainStreet])
  @@map("delivery_zones")
}

model DeliveryZoneStreet {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  zoneId       String       @map("zone_id")
  streetName   String       @map("street_name")
  displayOrder Int          @default(0) @map("display_order")
  zone         DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([streetName])
  @@map("delivery_zone_streets")
}

model CustomerLocation {
  id             String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  customerId     String        @map("customer_id")
  branchId       String        @map("branch_id")
  zoneId         String?       @map("zone_id")
  label          String        @default("Home")
  mainStreet     String        @map("main_street")
  subStreet      String?       @map("sub_street")
  buildingNumber String?       @map("building_number")
  floor          String?
  apartment      String?
  landmark       String?
  latitude       Float?
  longitude      Float?
  googlePlaceId  String?       @map("google_place_id")
  isDefault      Boolean       @default(false) @map("is_default")
  lastUsedAt     DateTime?     @db.Timestamptz(6) @map("last_used_at")
  createdAt      DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6) @map("updated_at")
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zone           DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([branchId])
  @@index([zoneId])
  @@map("customer_locations")
}

model RunningAccount {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  customerId     String    @unique @map("customer_id")
  branchId       String    @map("branch_id")
  creditLimit    Decimal   @default(1000) @map("credit_limit") @db.Decimal(10, 2)
  currentBalance Decimal   @default(0) @map("current_balance") @db.Decimal(10, 2)
  maxPaymentDays Int       @default(30) @map("max_payment_days")
  isBlocked      Boolean   @default(false) @map("is_blocked")
  lastPaymentAt  DateTime? @map("last_payment_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("running_accounts")
}

model RecipeBOM {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  productId   String    @map("product_id")
  inventoryId String    @map("inventory_id")
  quantity    Decimal   @db.Decimal(10, 3)
  unit        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([productId, inventoryId])
  @@map("recipe_boms")
}
