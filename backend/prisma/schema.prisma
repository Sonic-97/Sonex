// ── Unified Order Foundation (PR #1) ──
// New unified models alongside existing Order + InCafeOrder.
// No business logic migration yet — schema foundation only.

model UnifiedOrder {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId                String    @map("cafe_id")
  branchId              String    @map("branch_id")
  code                  String    @unique

  // ── Channel & Source (independent axes) ──
  channel               String    @default("IN_CAFE")
  source                String    @default("POS_TERMINAL")

  // ── Fulfillment lifecycle ──
  status                String    @default("NEW")
  cancelStatus          String?

  // ── Payment (independent axis) ──
  paymentStatus         String    @default("UNPAID")
  subtotal              Decimal   @default(0) @db.Decimal(10, 2)
  discountTotal         Decimal   @default(0) @db.Decimal(10, 2)
  grandTotal            Decimal   @default(0) @db.Decimal(10, 2)
  amountPaid            Decimal   @default(0) @db.Decimal(10, 2)
  changeTotal           Decimal   @default(0) @db.Decimal(10, 2)
  remainingAmount       Decimal   @default(0) @db.Decimal(10, 2)
  profit                Decimal?  @db.Decimal(10, 2)

  // ── Customer ──
  customerId            String?
  customerName          String?
  customerPhone         String?

  // ── Staff ──
  createdById           String?   @map("created_by_id")
  collectedById         String?   @map("collected_by_id")
  collectedRole         String?
  employeeId            String?   @map("employee_id")

  // ── Driver (DELIVERY channel only) ──
  driverId              String?

  // ── Delivery specifics ──
  address               String?

  // ── In-cafe specifics ──
  orderType             String    @default("DINE_IN")
  tableNumber           String?
  sourceType            String    @default("INSIDE_CAFE")

  // ── Priority / flags ──
  priority              String    @default("NORMAL")
  notes                 String?
  voidReason            String?

  // ── Inventory state ──
  stockDeducted         Boolean   @default(false)
  isRevenueConfirmed    Boolean   @default(false)

  // ── Legacy traceability ──
  legacyId              String?   @map("legacy_id")
  legacyTable           String?   @map("legacy_table")

  // ── Idempotency ──
  externalId            String?
  idempotencyKey        String?   @unique

  // ── Optimistic lock ──
  version               Int       @default(1)

  // ── Timestamps ──
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  confirmedAt           DateTime? @db.Timestamptz(6)
  preparedAt            DateTime? @db.Timestamptz(6)
  readyAt               DateTime? @db.Timestamptz(6)
  pickedUpAt            DateTime? @db.Timestamptz(6)
  deliveredAt           DateTime? @db.Timestamptz(6)
  paidAt                DateTime? @db.Timestamptz(6)
  closedAt              DateTime? @db.Timestamptz(6)
  cancelledAt           DateTime? @db.Timestamptz(6)
  voidedAt              DateTime? @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  // ── Relations ──
  items                 UnifiedOrderItem[]
  statusHistory         UnifiedOrderStatusHistory[]
  refunds               UnifiedRefund[]
  branch                Branch    @relation(fields: [branchId], references: [id])
  cafe                  Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  customer              Customer? @relation("UnifiedCustomerOrders", fields: [customerId], references: [id])
  createdBy             Staff?    @relation("UnifiedOrderCreatedBy", fields: [createdById], references: [id])
  collectedBy           Staff?    @relation("UnifiedOrderCollectedBy", fields: [collectedById], references: [id])
  employee              Staff?    @relation("UnifiedOrderBroughtBy", fields: [employeeId], references: [id])
  driver                Driver?   @relation(fields: [driverId], references: [id])
  merchantOrders        MerchantOrder[]

  @@unique([cafeId, code])
  @@unique([cafeId, externalId])
  @@index([cafeId, branchId])
  @@index([cafeId, branchId, status])
  @@index([cafeId, branchId, createdAt])
  @@index([cafeId, channel])
  @@index([cafeId, channel, status])
  @@index([cafeId, source])
  @@index([cafeId, paymentStatus])
  @@index([cafeId, driverId])
  @@index([cafeId, employeeId])
  @@index([customerId])
  @@index([status, cancelStatus])
  @@map("unified_orders")
}

