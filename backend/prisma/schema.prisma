generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  username  String   @unique
  password  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("super_admins")
}

model Cafe {
  id                     String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                   String
  phone                  String                 @unique
  address                String?
  logo                   String?
  ownerCode              String                 @unique
  ownerPassword          String
  active                 Boolean                @default(true)
  cafeCode               String?                @unique @map("cafe_code")
  category               String?
  currency               String                 @default("EGP")
  timezone               String                 @default("Africa/Cairo")
  configuration          Json                   @default("{}")
  whatsappPhoneId        String?                @map("whatsapp_phone_id")
  whatsappBusinessId     String?                @map("whatsapp_business_id")
  whatsappAccessToken    String?                @map("whatsapp_access_token")
  ownerId                String?                @map("owner_id")
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)
  orders                 Order[]
  staffs                 Staff[]
  addOnIngredients       AddOnIngredient[]
  aiLogs                 AILog[]
  analyticsCaches        AnalyticsCache[]
  attendances            Attendance[]
  auditLogs              AuditLog[]
  subscription           BillingSubscription?
  branchProducts         BranchProduct[]
  branches               Branch[]
  cashHandovers          CashHandover[]
  costSnapshots          CostSnapshot[]
  customUnits            CustomUnit[]
  customerHabits         CustomerHabit[]
  customers              Customer[]
  dailyRevenues          DailyRevenue[]
  deadLetters            DeadLetter[]
  debts                  Debt[]
  driversCashSettlements DriverCashSettlement[]
  driverEarnings         DriverEarning[]
  drivers                Driver[]
  employeePayments       EmployeePayment[]
  expenses               Expense[]
  financialTransactions  FinancialTransaction[]
  fraudAlerts            FraudAlert[]
  inCafeOrderItems       InCafeOrderItem[]
  inCafeOrders           InCafeOrder[]
  inventories            Inventory[]
  inventoryConsumptions  InventoryConsumption[]
  inventoryPurchases     InventoryPurchase[]
  inventorySyncLogs      InventorySyncLog[]
  invoices               Invoice[]
  lidMappings            LidMapping[]
  messages               Message[]
  notifications          Notification[]
  packagingMaterials     PackagingMaterial[]
  paymentLogs            PaymentLog[]
  payments               Payment[]
  pendingReplies         PendingReply[]
  playstationDevices     PlayStationDevice[]
  playstationPricing     PlayStationPricing?
  playstationSessions    PlayStationSession[]
  priceChangeLogs        PriceChangeLog[]
  priceOverrides         PriceOverride[]
  processedMessages      ProcessedMessage[]
  productCategories      ProductCategory[]
  productOptions         ProductOption[]
  productSizes           ProductSize[]
  products               Product[]
  pushSubscriptions      PushSubscription[]
  queueJobLogs           QueueJobLog[]
  recipeIngredients      RecipeIngredient[]
  recipeVersions         RecipeVersion[]
  refrigeratorCategories RefrigeratorCategory[]
  reportJobs             ReportJob[]
  staffEarnings          StaffEarning[]
  staffPerformances      StaffPerformance[]
  staffPurchases         StaffPurchase[]
  stockLedgerEntries     StockLedger[]
  stockReservations      StockReservation[]
  suggestionFeedback     SuggestionFeedback[]
  suggestions            Suggestion[]
  whatsappCustomers      WhatsappCustomer[]
  whatsappLogs           WhatsAppLog[]
  telegramChats          TelegramChat[]
  telegramSessions       TelegramSession[]
  telegramMessageLogs    TelegramMessageLog[]
  telegramBotToken       String?                @unique @map("telegram_bot_token")
  telegramBotUsername    String?                @map("telegram_bot_username")
  telegramWebhookToken   String?                @map("telegram_webhook_token")
  telegramEnabled        Boolean                @default(false) @map("telegram_enabled")
  telegramCafeToken      String?                @unique @map("telegram_cafe_token")
  unifiedOrders          UnifiedOrder[]
  unifiedOrderItems      UnifiedOrderItem[]
  unifiedOrderStatusHistories UnifiedOrderStatusHistory[]
  unifiedRefunds         UnifiedRefund[]
  merchantOrders         MerchantOrder[]
  merchantAvailability   MerchantAvailability?
  onboardingSessions     OnboardingSession[]
  taxes                  Tax[]
  paymentMethods         PaymentMethod[]
  suppliers              Supplier[]
  dynamicPricingRules    DynamicPricingRule[]
  deliveryZones          DeliveryZone[]

  @@index([ownerCode])
  @@index([phone])
  @@map("cafes")
}

model Branch {
  id                    String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId                String                 @map("cafe_id")
  name                  String
  slug                  String
  location              String?
  phone                 String?
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  orders                Order[]
  staffs                Staff[]
  analyticsCaches       AnalyticsCache[]
  branchProducts        BranchProduct[]
  cafe                  Cafe                   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  customers             Customer[]
  dailyRevenues         DailyRevenue[]
  debts                 Debt[]
  driverCashSettlements DriverCashSettlement[]
  driverEarnings        DriverEarning[]
  drivers               Driver[]
  employeePayments      EmployeePayment[]
  expenses              Expense[]
  inCafeOrders          InCafeOrder[]
  inventories           Inventory[]
  inventoryPurchases    InventoryPurchase[]
  inventorySyncLogs     InventorySyncLog[]
  notifications         Notification[]
  paymentLogs           PaymentLog[]
  payments              Payment[]
  priceOverrides        PriceOverride[]
  productCategories     ProductCategory[]
  products              Product[]
  pushSubscriptions     PushSubscription[]
  reportJobs            ReportJob[]
  staffEarnings         StaffEarning[]
  staffPerformances     StaffPerformance[]
  staffPurchases        StaffPurchase[]
  whatsappCustomers     WhatsappCustomer[]
  unifiedOrders         UnifiedOrder[]
  unifiedOrderItems     UnifiedOrderItem[]
  deliveryZones         DeliveryZone[]
  customerLocations     CustomerLocation[]

  @@unique([cafeId, slug])
  @@index([cafeId])
  @@map("branches")
}

model Customer {
  id                String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId            String         @map("cafe_id")
  branchId          String         @map("branch_id")
  phone             String
  name              String?
  preferredLanguage String?                @default("ar-EG")
  favoriteDrink     String?
  totalOrders       Int            @default(0)
  totalSpent        Decimal        @default(0) @db.Decimal(10, 2)
  unpaidBalance     Decimal        @default(0) @db.Decimal(10, 2)
  lastOrderDate     DateTime?      @db.Timestamptz(6)
  preferredProducts Json?
  savedAddresses    Json           @default("[]")
  totalCafeVisits   Int            @default(0)
  totalCafeSpent    Decimal        @default(0) @db.Decimal(10, 2)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  phoneJid          String?        @map("phone_jid")
  lastResolvedAt    DateTime?      @db.Timestamptz(6)
  lastKnownJid      String?        @map("last_known_jid")
  lidJid            String?        @map("lid_jid")
  telegramId        BigInt?        @map("telegram_id")
  telegramUsername  String?        @map("telegram_username")
  orders            Order[]
  habit             CustomerHabit?
  runningAccount    RunningAccount?
  branch            Branch         @relation(fields: [branchId], references: [id])
  cafe              Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  debts             Debt[]
  inCafeOrders      InCafeOrder[]  @relation("CafeOrders")
  suggestions       Suggestion[]
  telegramChats     TelegramChat[]
  unifiedOrders     UnifiedOrder[] @relation("UnifiedCustomerOrders")
  customerLocations CustomerLocation[]

  @@unique([cafeId, branchId, phone])
  @@unique([cafeId, telegramId])
  @@index([cafeId, branchId, name])
  @@index([phoneJid])
  @@index([lidJid])
  @@index([telegramId])
  @@map("customers")
}

model Staff {
  id                        String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId                    String                 @map("cafe_id")
  branchId                  String                 @map("branch_id")
  name                      String
  email                     String?                @unique
  role                      String
  phone                     String                 @unique
  pinHash                   String
  active                    Boolean                @default(true)
  loginCode                 String?                @unique
  password                  String?                @map("password")
  salary                    Decimal                @default(0) @db.Decimal(10, 2)
  salaryType                String                 @default("MONTHLY")
  language                  String                 @default("en")
  hourlyWage                Decimal?               @default(0) @db.Decimal(10, 2)
  currentCashWallet         Decimal                @default(0) @db.Decimal(10, 2)
  collectedPayments         Order[]                @relation("CollectedPayments")
  createdOrders             Order[]                @relation("OrderCreatedBy")
  broughtOrders             Order[]                @relation("OrderBroughtBy")
  orders                    Order[]
  branch                    Branch                 @relation(fields: [branchId], references: [id])
  cafe                      Cafe                   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  attendances               Attendance[]
  cashHandovers             CashHandover[]
  approvedSettlements       DriverCashSettlement[] @relation("ApprovedSettlements")
  employeePayments          EmployeePayment[]
  expenses                  Expense[]
  financialTransactions     FinancialTransaction[]
  cafeOrders                InCafeOrder[]          @relation("CafeCreatedBy")
  broughtInCafeOrders       InCafeOrder[]          @relation("InCafeOrderBroughtBy")
  inventoryPurchases        InventoryPurchase[]
  notifications             Notification[]
  paymentLogs               PaymentLog[]
  playstationSessionsClosed PlayStationSession[]   @relation("PSClosedBy")
  playstationSessions       PlayStationSession[]   @relation("PSOpenedBy")
  priceChanges              PriceChangeLog[]
  priceOverrides            PriceOverride[]
  pushSubscription          PushSubscription?
  refreshTokens             RefreshToken[]
  reportJobs                ReportJob[]
  earning                   StaffEarning?
  performances              StaffPerformance[]
  purchases                 StaffPurchase[]
  unifiedCreatedOrders      UnifiedOrder[]     @relation("UnifiedOrderCreatedBy")
  unifiedCollectedOrders    UnifiedOrder[]     @relation("UnifiedOrderCollectedBy")
  unifiedBroughtOrders      UnifiedOrder[]     @relation("UnifiedOrderBroughtBy")
  unifiedRefunds            UnifiedRefund[]

  @@index([cafeId, branchId])
  @@index([cafeId, role])
  @@index([loginCode])
  @@index([active])
}

model Attendance {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId     String    @map("cafe_id")
  staffId    String    @map("staff_id")
  clockIn    DateTime  @map("clock_in") @db.Timestamptz(6)
  clockOut   DateTime? @map("clock_out") @db.Timestamptz(6)
  totalHours Float?    @map("total_hours")
  date       DateTime  @db.Date
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  cafe       Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([cafeId, staffId])
  @@index([cafeId, date])
  @@index([cafeId, date, status])
  @@index([cafeId, staffId, date])
  @@index([status])
  @@map("attendances")
}

model CashHandover {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId           String    @map("cafe_id")
  staffId          String    @map("staff_id")
  amount           Decimal   @default(0) @db.Decimal(10, 2)
  status           String    @default("ACTIVE")
  notes            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  confirmedByOwner DateTime? @db.Timestamptz(6)
  deliveredCash    Decimal?  @db.Decimal(10, 2)
  expectedCash     Decimal   @default(0) @db.Decimal(10, 2)
  shiftEnd         DateTime? @db.Timestamptz(6)
  shiftStart       DateTime  @default(now()) @db.Timestamptz(6)
  cafe             Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  staff            Staff     @relation(fields: [staffId], references: [id])

  @@index([cafeId, staffId])
  @@index([createdAt])
  @@index([status])
  @@map("cash_handovers")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      Staff    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ProductCategory {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId    String    @map("cafe_id")
  branchId  String?   @map("branch_id")
  name      String
  icon      String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  color     String?
  code      String?   @map("code")
  branch    Branch?   @relation(fields: [branchId], references: [id])
  cafe      Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([cafeId, branchId, name])
  @@unique([cafeId, code])
  @@index([cafeId, branchId])
  @@map("product_categories")
}

model RefrigeratorCategory {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId    String    @map("cafe_id")
  name      String
  emoji     String    @default("🥤")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  products  Product[] @relation("RefrigeratorProducts")
  cafe      Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@map("refrigerator_categories")
}

model Product {
  id                      String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId                  String                @map("cafe_id")
  branchId                String?               @map("branch_id")
  name                    String
  category                String                @default("general")
  categoryId              String?               @map("category_id")
  description             String?
  understandingTags       Json                  @default("[]") @map("understanding_tags")
  price                   Decimal               @db.Decimal
  cost                    Decimal               @db.Decimal
  cafePrice               Decimal?              @db.Decimal
  active                  Boolean               @default(true)
  emoji                   String                @default("")
  images                  Json                  @default("[]")
  attributes              Json                  @default("[]")
  tags                    Json                  @default("[]")
  variants                Json                  @default("[]")
  availability            Json                  @default("{}")
  isRefrigerated          Boolean               @default(false)
  lowStockThreshold       Int                   @default(0)
  refrigeratorStock       Int                   @default(0)
  refrigeratorCategoryId  String?               @map("refrigerator_category_id")
  refrigeratorInventoryId String?               @map("refrigerator_inventory_id")
  code                    String?               @map("code")
  orderItems              OrderItem[]
  addOns                  AddOnIngredient[]
  branchProducts          BranchProduct[]
  boms                    RecipeBOM[]
  costSnapshots           CostSnapshot[]
  cafeOrderItems          InCafeOrderItem[]
  packaging               PackagingMaterial[]
  priceChanges            PriceChangeLog[]
  priceOverrides          PriceOverride[]
  options                 ProductOption[]
  sizes                   ProductSize[]
  branch                  Branch?               @relation(fields: [branchId], references: [id])
  cafe                    Cafe                  @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  categoryRel             ProductCategory?      @relation(fields: [categoryId], references: [id])
  refrigeratorCategory    RefrigeratorCategory? @relation("RefrigeratorProducts", fields: [refrigeratorCategoryId], references: [id])
  refrigeratorInventory   Inventory?            @relation("RefrigeratorInventory", fields: [refrigeratorInventoryId], references: [id])
  recipe                  RecipeIngredient[]
  recipeVersions          RecipeVersion[]
  staffPurchases          StaffPurchase[]
  favoriteInHabits        CustomerHabit[]       @relation("CustomerFavoriteProduct")
  unifiedOrderItems        UnifiedOrderItem[]

  @@unique([cafeId, code])
  @@index([cafeId, branchId])
  @@index([cafeId, branchId, active])
  @@index([refrigeratorCategoryId])
  @@map("products")
}

model RecipeIngredient {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId       String    @map("cafe_id")
  productId    String    @map("product_id")
  inventoryId  String    @map("inventory_id")
  quantity     Decimal   @db.Decimal(10, 3)
  unit         String    @default("g")
  notes        String?
  emoji        String?   @default("🫘")
  wastePercent Decimal   @default(0) @db.Decimal(5, 2)
  cafe         Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  inventory    Inventory @relation(fields: [inventoryId], references: [id])
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cafeId, productId, inventoryId])
  @@index([cafeId, inventoryId])
  @@map("recipe_ingredients")
}

model RecipeVersion {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId        String   @map("cafe_id")
  productId     String   @map("product_id")
  versionNumber Int
  snapshot      Json
  totalCost     Decimal  @db.Decimal(10, 2)
  createdBy     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  cafe          Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cafeId, productId])
  @@map("recipe_versions")
}

model ProductSize {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId      String   @map("cafe_id")
  productId   String   @map("product_id")
  name        String
  sortOrder   Int      @default(0)
  priceAdjust Decimal  @default(0) @db.Decimal(10, 2)
  costPercent Decimal  @default(100) @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cafeId, productId, name])
  @@index([cafeId, productId])
  @@map("product_sizes")
}

model AddOnIngredient {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId      String    @map("cafe_id")
  productId   String    @map("product_id")
  name        String
  price       Decimal   @default(0) @db.Decimal(10, 2)
  inventoryId String    @map("inventory_id")
  quantity    Decimal   @db.Decimal(10, 3)
  unit        String    @default("g")
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  cafe        Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cafeId, productId])
  @@map("add_on_ingredients")
}

model PackagingMaterial {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId      String    @map("cafe_id")
  productId   String    @map("product_id")
  name        String
  inventoryId String    @map("inventory_id")
  quantity    Decimal   @default(1) @db.Decimal(10, 3)
  unit        String    @default("piece")
  cafe        Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cafeId, productId])
  @@map("packaging_materials")
}

model CostSnapshot {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId         String   @map("cafe_id")
  productId      String   @map("product_id")
  orderItemId    String?  @map("order_item_id")
  ingredientCost Decimal  @db.Decimal(10, 2)
  packagingCost  Decimal  @default(0) @db.Decimal(10, 2)
  laborCost      Decimal  @default(0) @db.Decimal(10, 2)
  overheadCost   Decimal  @default(0) @db.Decimal(10, 2)
  totalCost      Decimal  @db.Decimal(10, 2)
  sellingPrice   Decimal  @db.Decimal(10, 2)
  sizeName       String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  cafe           Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cafeId, productId])
  @@index([cafeId, createdAt])
  @@map("cost_snapshots")
}

model ProductOption {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId      String   @map("cafe_id")
  productId   String   @map("product_id")
  name        String
  required    Boolean  @default(false)
  multiSelect Boolean  @default(false)
  choices     Json     @default("[]")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cafeId, productId])
  @@map("product_options")
}

model PriceChangeLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId      String   @map("cafe_id")
  productId   String   @map("product_id")
  oldPrice    Decimal  @db.Decimal(10, 2)
  newPrice    Decimal  @db.Decimal(10, 2)
  oldCost     Decimal? @db.Decimal(10, 2)
  newCost     Decimal? @db.Decimal(10, 2)
  changedById String?  @map("changed_by_id")
  reason      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  changedBy   Staff?   @relation(fields: [changedById], references: [id])
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cafeId, productId])
  @@index([cafeId, createdAt])
  @@map("price_change_logs")
}

model Driver {
  id                   String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  cafeId               String                 @map("cafe_id")
  branchId             String                 @map("branch_id")
  name                 String
  phone                String                 @unique
  active               Boolean                @default(true)
  totalDeliveries      Int                    @default(0)
  totalRevenue         Decimal                @default(0) @db.Decimal(10, 2)
  newCustomersAcquired Int                    @default(0)
  bonusEligible        Boolean                @default(false)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  orders               Order[]
  cashSettlements      DriverCashSettlement[]
  earning              DriverEarning?
  branch               Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cafe                 Cafe                   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  unifiedOrders           UnifiedOrder[]
  customerOrders          CustomerOrder[]
  dispatchAssignments     DriverAssignment[]
  driverStatus            String                @default("OFFLINE") @map("driver_status")
  merchantZoneId          String?               @map("merchant_zone_id")
  vehicleType             String                @default("motorcycle") @map("vehicle_type")
  currentLatitude         Decimal?              @db.Decimal(10, 7) @map("current_latitude")
  currentLongitude        Decimal?              @db.Decimal(10, 7) @map("current_longitude")
  currentLocation         Json                  @default("{}") @map("current_location")
  capacity                Int                   @default(1)
  activeAssignments       Int                   @default(0) @map("active_assignments")
  lastHeartbeat           DateTime?             @map("last_heartbeat")
  acceptanceRate          Decimal               @default(1.0) @db.Decimal(3, 2) @map("acceptance_rate")

  @@index([cafeId, branchId])
  @@index([cafeId, active])
  @@index([driverStatus])
  @@index([merchantZoneId])
  @@map("drivers")
}

model Order {
  id                   String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                 String       @unique
  cafeId               String       @map("cafe_id")
  branchId             String       @map("branch_id")
  customerId           String
  staffId              String?
  driverId             String?
