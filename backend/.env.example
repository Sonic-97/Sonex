# =============================================================================
# Sonex Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all values before running.
# Required variables are marked [REQUIRED]
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/sonex?schema=public"
# [REQUIRED] PostgreSQL connection string

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
# [REQUIRED] Used to sign access tokens
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
# [REQUIRED] Used to sign refresh tokens
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- AI ---
DEEPSEEK_API_KEY=
# Optional — leave empty to use local decision engine only

# --- WhatsApp ---
WHATSAPP_PROVIDER=openwa
OPENWA_API_URL=http://localhost:2785/api
OPENWA_SESSION_ID=
OPENWA_SESSION_NAME=sonic-coffee
OPENWA_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- URLs ---
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
PORT=5000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_WEBHOOK_URL=
