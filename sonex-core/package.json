{
  "name": "@sonex/core",
  "version": "0.1.0",
  "description": "Sonex shared business logic core (Rust via napi-rs)",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "sonex-core",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --js index.js --dts index.d.ts",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "2.18.4"
  }
}
